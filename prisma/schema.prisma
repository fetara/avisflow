generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles : SUPER_ADMIN (plateforme) | COMPANY_ADMIN (utilisateur d'une entreprise)
// Le legacy "admin" (sessions/comples existants) est traité comme SUPER_ADMIN.
model Admin {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  role            String    @default("SUPER_ADMIN")
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Matrice de droits (JSON string), uniquement pour COMPANY_ADMIN.
  // Clés : manage_prizes | configure_wheel | manage_qrcodes | view_customers | moderate_reviews | view_stats
  permissions     String    @default("[]")
  emailVerifiedAt DateTime?
  totpSecret      String?
  twoFactorEnabled Boolean  @default(true)
  loginSessions   LoginSession[]
  emailTokens     EmailToken[]
  moderatedReviews Review[] @relation("Moderator")
  createdQrCodes  QrCode[]
  auditLogs       AuditLog[]
  createdAt       DateTime  @default(now())
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  // 2FA imposée au niveau entreprise (false = 2FA ignorée pour tous ses admins)
  twoFactorEnabled Boolean @default(true)
  admins    Admin[]
  qrCodes   QrCode[]
  prizes    Prize[]
  customers Customer[]
  settings  CompanySetting[]
  createdAt DateTime @default(now())
}

model LoginSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model EmailToken {
  id        String    @id @default(cuid())
  adminId   String?
  admin     Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  type      String    // VALIDATE_EMAIL | RESET_PASSWORD | CUSTOMER_VERIFY
  payload   String?   // JSON libre (ex: données client en attente)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Customer {
  id         String    @id @default(cuid())
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  phone      String?
  consentAt  DateTime
  emailVerifiedAt DateTime?
  sourceQrId String?
  sourceQr   QrCode?   @relation(fields: [sourceQrId], references: [id], onDelete: SetNull)
  anonymizedAt DateTime?
  spins      Spin[]
  reviews    Review[]
  createdAt  DateTime  @default(now())

  // Un e-mail est unique PAR entreprise (le même client peut jouer chez plusieurs commerces)
  @@unique([companyId, email])
}

model QrCode {
  id         String    @id @default(cuid())
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label      String
  slug       String    @unique
  active     Boolean   @default(true)
  destination String   @default("/jeu")
  expiresAt  DateTime?
  createdBy  String?
  creator    Admin?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  scans      QrScan[]
  customers  Customer[]
  createdAt  DateTime  @default(now())
}

model QrScan {
  id        String   @id @default(cuid())
  qrCodeId  String
  qrCode    QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  sessionId String
  userAgent String?
  ipHash    String?
  scannedAt DateTime @default(now())

  @@index([qrCodeId, scannedAt])
}

model Prize {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  weight    Int      @default(1)
  stock     Int?     // null = illimité
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  photo     String?  // data URL de l'illustration du lot (affichée au joueur)
  spins     Spin[]
  createdAt DateTime @default(now())
}

model Spin {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  prizeId    String
  prize      Prize    @relation(fields: [prizeId], references: [id])
  giftCode   String   @unique
  createdAt  DateTime @default(now())
}

model Review {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  photo       String?   // URL/data de la photo optionnelle
  status      String    @default("pending") // pending | approved | rejected | hidden
  autoApplied Boolean   @default(false)
  googleClick Boolean   @default(false)
  reply       String?
  moderatedBy String?
  moderator   Admin?    @relation("Moderator", fields: [moderatedBy], references: [id], onDelete: SetNull)
  moderatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

model Setting {
  key   String @id
  value String
}

// Réglages de la roue / du jeu, isolés par entreprise
model CompanySetting {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@unique([companyId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}
